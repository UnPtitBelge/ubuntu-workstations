#!/usr/bin/env python3
"""Read-only workstation health check; generated by Ansible."""

import datetime
import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path

DISK_WARNING_PERCENT = {{ workstation_health_disk_warning_percent | int }}
TIMEOUT_SECONDS = 15


def run(*args):
    try:
        result = subprocess.run(
            args, capture_output=True, text=True,
            timeout=TIMEOUT_SECONDS, check=False,
        )
        return result.returncode, (result.stdout or result.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)


def main():
    warnings = []
    lines = [
        "WORKSTATION HEALTH REPORT",
        "Host: " + socket.gethostname(),
        "Time: " + datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "",
    ]

    def record(ok, label, detail):
        lines.append("[{}] {}: {}".format("OK" if ok else "WARN", label, detail))
        if not ok:
            warnings.append(label)

    def check_disk(path):
        try:
            usage = shutil.disk_usage(path)
            percent = round(100 * usage.used / usage.total)
            record(percent < DISK_WARNING_PERCENT, "Disk " + str(path),
                   "{}% used (warning threshold: {}%)".format(percent, DISK_WARNING_PERCENT))
        except OSError as exc:
            record(False, "Disk " + str(path), str(exc))

    def check_service(service, user=False):
        argv = ["systemctl"]
        if user:
            argv.append("--user")
        code, output = run(*argv, "is-active", service)
        record(code == 0 and output == "active", service, output or "unknown")

    def check_timer(timer):
        enabled_code, enabled = run("systemctl", "is-enabled", timer)
        active_code, active = run("systemctl", "is-active", timer)
        record(enabled_code == 0 and enabled == "enabled" and
               active_code == 0 and active == "active", timer,
               "enabled={}; active={}".format(enabled or "unknown", active or "unknown"))

    check_disk("/")
    home = Path.home()
    try:
        if os.stat("/").st_dev != os.stat(home).st_dev:
            check_disk(home)
    except OSError as exc:
        record(False, "Home filesystem", str(exc))

{% for service in workstation_health_system_services %}
    check_service({{ service | to_json }})
{% endfor %}
{% for service in workstation_health_user_services %}
    check_service({{ service | to_json }}, user=True)
{% endfor %}
{% for timer in workstation_health_system_timers %}
    check_timer({{ timer | to_json }})
{% endfor %}

    reboot_needed = Path("/var/run/reboot-required").exists()
    record(not reboot_needed, "Reboot required", "yes" if reboot_needed else "no")

    lines.extend(["", "OVERALL: ATTENTION REQUIRED" if warnings else "OVERALL: HEALTHY"])
    report = "\n".join(lines) + "\n"

    destination = home / ".local" / "state" / "workstation-health"
    try:
        destination.mkdir(parents=True, exist_ok=True)
        (destination / "latest.txt").write_text(report, encoding="utf-8")
    except OSError as exc:
        print("Cannot write health report: {}".format(exc), file=sys.stderr)
        print(report, end="")
        return 2

    print(report, end="")
    return 1 if warnings else 0


if __name__ == "__main__":
    sys.exit(main())
