// Managed by Ansible: ansible/roles/maintenance
// Deliberately keep automatic feature and third-party package updates outside this policy.
APT::Periodic::Update-Package-Lists "{{ workstation_maintenance_security_update_period_days }}";
APT::Periodic::Unattended-Upgrade "{{ workstation_maintenance_security_update_period_days }}";

// APT list options append rather than replace: clear earlier entries explicitly.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
  "${distro_id}:${distro_codename}";
  "${distro_id}:${distro_codename}-security";
  "${distro_id}ESMApps:${distro_codename}-apps-security";
  "${distro_id}ESMApps:${distro_codename}-apps-legacy-security";
  "${distro_id}ESM:${distro_codename}-infra-security";
  "${distro_id}ESM:${distro_codename}-infra-legacy-security";
};

Unattended-Upgrade::Automatic-Reboot "{{ 'true' if workstation_maintenance_automatic_reboot else 'false' }}";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
