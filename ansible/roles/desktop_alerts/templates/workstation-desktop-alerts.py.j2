#!/usr/bin/env python3
"""Notify the logged-in desktop user only when workstation reports need attention.

Read-only toward monitored services/configuration; never runs a backup or repair.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

SOURCES = (
{% for source in workstation_report_sources %}
    ({{ source.name | to_json }}, {{ source.path | to_json }}, {{ source.expected | to_json }}{% if source.max_age_hours is defined %}, {{ source.max_age_hours | float }}{% endif %}),
{% endfor %}
)
OVERALL_RE = re.compile(r"^OVERALL:\s*(.+?)\s*$", re.MULTILINE)
DETAIL_RE = re.compile(r"^\[(?:WARN|DRIFT|FAIL|ERROR)\]\s*(.+)$", re.MULTILINE)


def problems(home: Path, max_age_hours: float, now: float):
    issues = []
    for entry in SOURCES:
        name, relative, healthy_status = entry[0], entry[1], entry[2]
        max_age = entry[3] if len(entry) > 3 else max_age_hours
        path = home / relative
        try:
            stat = path.stat()
            report = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            issues.append((name, f"report unavailable ({type(exc).__name__})"))
            continue
        age_hours = (now - stat.st_mtime) / 3600
        if not 0 <= age_hours <= max_age:
            issues.append((name, f"report stale ({age_hours:.1f}h old)"))
        statuses = OVERALL_RE.findall(report)
        if len(statuses) != 1:
            issues.append((name, "report has no unambiguous OVERALL status"))
        elif statuses[0].strip() != healthy_status:
            details = DETAIL_RE.findall(report)
            reason = details[0].strip() if details else statuses[0].strip()
            issues.append((name, reason[:140]))
    # Post-update validation is event-driven, not a daily health snapshot.
    # Its latest report may be absent before the first update or old after a
    # successful validation. Alert only on an explicit unhealthy result.
    update_report = home / ".local/state/workstation-post-update/latest.txt"
    if update_report.exists():
        try:
            content = update_report.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            issues.append(("Post-update validation", f"report unreadable ({type(exc).__name__})"))
        else:
            statuses = OVERALL_RE.findall(content)
            if len(statuses) != 1:
                issues.append(("Post-update validation", "report has no unambiguous OVERALL status"))
            elif statuses[0].strip() != "HEALTHY":
                details = DETAIL_RE.findall(content)
                reason = details[0].strip() if details else statuses[0].strip()
                issues.append(("Post-update validation", reason[:140]))
    return issues


def notify(title: str, message: str):
    # Self-test hook: record instead of calling notify-send.
    if os.environ.get("WORKSTATION_ALERTS_STUB_NOTIFY"):
        print(f"STUB NOTIFY: {title} | {message.splitlines()[0]}")
        return True
    try:
        result = subprocess.run(
            ["notify-send", "--app-name=Workstation Maintenance", "--urgency=critical",
             "--expire-time=15000", title, message],
            capture_output=True, text=True, timeout=15, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"Notification not delivered: {exc}", file=sys.stderr)
        return False
    if result.returncode != 0:
        print(f"Notification not delivered: {result.stderr.strip()}", file=sys.stderr)
    return result.returncode == 0


def self_test():
    """Exercise failure -> notify, duplicate suppression, post-update failure
    surfacing and recovery in a temporary home. No real notification is sent
    (notify is stubbed) and no real report is read."""
    import tempfile
    failures = []

    def expect(condition, name):
        print(("PASS: " if condition else "FAIL: ") + name)
        if not condition:
            failures.append(name)

    def write_source(home, relative, overall, detail=None):
        path = home / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        lines = ["TEST REPORT", "Host: selftest", ""]
        if detail:
            lines.append(f"[{detail}] something broke")
        lines += ["", f"OVERALL: {overall}"]
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    with tempfile.TemporaryDirectory(prefix="workstation-alerts-selftest-") as tmp:
        home = Path(tmp)
        os.environ["WORKSTATION_ALERTS_HOME"] = tmp
        os.environ["WORKSTATION_ALERTS_STUB_NOTIFY"] = "1"
        state = home / ".local/state/workstation-desktop-alerts/last-alert.json"
        try:
            # 1. All reports healthy -> no alert, exit 0, no state file.
            for name, relative, expected in [(s[0], s[1], s[2]) for s in SOURCES]:
                write_source(home, relative, expected)
            rc = main([])
            expect(rc == 0, "healthy reports produce no alert (exit 0)")
            expect(not state.exists(), "no alert state is written when healthy")

            # 2. One unhealthy report -> notification sent, state recorded.
            bad = SOURCES[0]
            write_source(home, bad[1], "ATTENTION REQUIRED", detail="FAIL")
            rc = main([])
            expect(rc == 0, "unhealthy report still exits 0 (alert delivered)")
            expect(state.exists(), "sent alert records its fingerprint")

            # 3. Same problem again within repeat-hours -> suppressed.
            import io
            from contextlib import redirect_stdout
            buf = io.StringIO()
            with redirect_stdout(buf):
                main([])
            expect("SUPPRESSED" in buf.getvalue(), "duplicate alert within repeat-hours is suppressed")

            # 4. A different failure (post-update validation) -> fresh alert.
            write_source(home, ".local/state/workstation-post-update/latest.txt", "ATTENTION REQUIRED", detail="FAIL")
            buf = io.StringIO()
            with redirect_stdout(buf):
                main([])
            expect("SENT" in buf.getvalue(), "a new failure raises a fresh alert despite suppression")

            # 5. Recovery: all reports healthy again -> state cleared.
            for name, relative, expected in [(s[0], s[1], s[2]) for s in SOURCES]:
                write_source(home, relative, expected)
            write_source(home, ".local/state/workstation-post-update/latest.txt", "HEALTHY")
            buf = io.StringIO()
            with redirect_stdout(buf):
                rc = main([])
            expect("HEALTHY" in buf.getvalue() and rc == 0, "recovery is reported as HEALTHY")
            expect(not state.exists(), "recovery clears the saved fingerprint")
        finally:
            os.environ.pop("WORKSTATION_ALERTS_HOME", None)
            os.environ.pop("WORKSTATION_ALERTS_STUB_NOTIFY", None)
    if failures:
        print(f"SELF-TEST FAILED: {len(failures)} scenario(s) failed", file=sys.stderr)
        return 1
    print("SELF-TEST PASSED: failure, suppression, fresh-failure and recovery all behave as expected.")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--max-report-age-hours", type=float, default=48,
                        help="Default maximum report age; per-source max_age_hours overrides it")
    parser.add_argument("--repeat-hours", type=float, default=24)
    parser.add_argument("--dry-run", action="store_true", help="Show decisions, do not notify or write state")
    parser.add_argument("--test-notification", action="store_true", help="Send one explicit test notification")
    parser.add_argument("--test-post-update-failure", action="store_true",
                        help="Simulate a post-update failure in dry-run mode only")
    parser.add_argument("--self-test", action="store_true",
                        help="Exercise failure -> notify, duplicate suppression and recovery in a temp home; no real notification is sent")
    args = parser.parse_args(argv)
    if args.test_post_update_failure and not args.dry_run:
        parser.error("--test-post-update-failure requires --dry-run")
    if args.max_report_age_hours <= 0 or args.repeat_hours <= 0:
        parser.error("age and repeat intervals must be positive")
    if args.test_notification:
        return 0 if notify("Workstation alerts test", "Desktop notifications are working.") else 1
    if args.self_test:
        return self_test()

    home = Path(os.environ.get("WORKSTATION_ALERTS_HOME", str(Path.home())))
    now = time.time()
    issues = problems(home, args.max_report_age_hours, now)
    if args.test_post_update_failure:
        issues.append(("Post-update validation", "simulated Docker API failure"))
    state = home / ".local/state/workstation-desktop-alerts/last-alert.json"
    if not issues:
        print("HEALTHY: no alerts needed")
        # Clear saved fingerprint on recovery so a recurrence raises a fresh alert.
        if not args.dry_run:
            state.unlink(missing_ok=True)
        return 0

    for name, reason in issues:
        print(f"ATTENTION: {name}: {reason}")
    fingerprint = hashlib.sha256(
        json.dumps([(name, "stale" if reason.startswith("report stale")
                         else "unavailable" if reason.startswith("report unavailable")
                         else "unhealthy") for name, reason in issues],
                   ensure_ascii=False).encode("utf-8")
    ).hexdigest()
    previous = {}
    try:
        previous = json.loads(state.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        pass
    if (previous.get("fingerprint") == fingerprint
            and 0 <= now - float(previous.get("last_sent", 0)) < args.repeat_hours * 3600):
        print("SUPPRESSED: same problem already notified recently")
        return 0

    title = f"Workstation attention required ({len(issues)})"
    body = "\n".join(f"{name}: {reason}" for name, reason in issues[:3])
    if len(issues) > 3:
        body += f"\n... and {len(issues) - 3} more"
    body += "\nSee ~/.local/state/workstation-*/latest.txt"
    if args.dry_run:
        print(f"DRY RUN: would notify: {title}\n{body}")
        return 0

    # Do not record a notification unless the desktop notification service accepted it.
    # With no GNOME session, this may fail; a subsequent timer run will retry.
    if not notify(title, body):
        return 0
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps({"fingerprint": fingerprint, "last_sent": now}) + "\n",
                     encoding="utf-8")
    print("SENT: desktop notification")
    return 0


if __name__ == "__main__":
    sys.exit(main())
