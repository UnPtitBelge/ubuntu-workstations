{
  "schema": 2,
  "description": "Baseline generated after Ansible workstation provisioning. Re-running Ansible refreshes it; the drift checker logs every re-baseline to baseline-updates.jsonl.",
  "generated_at": "{{ ansible_date_time.iso8601 }}",
  "host": "{{ ansible_facts['hostname'] }}",
  "files": [
{% for result in workstation_drift_file_stats.results %}
    {"label": {{ result.item.label | to_json }}, "path": {{ result.item.path | to_json }}, "sha256": {{ (result.stat.checksum | default('')) | to_json }}}{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
