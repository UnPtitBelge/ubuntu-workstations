#!/usr/bin/env bash
set -euo pipefail

# Monthly restore drill: download ONE backed-up file from the remote dataset
# to a separate temporary location and compare its SHA-256 with the local
# source. Read-only on the remote (a download only); never deletes or
# overwrites anything. Result is recorded in restore-tests.jsonl and
# status.json (verified_restore_at) — an upload alone never proves
# restorability.
cli={{ workstation_backup_proton_cli | quote }}
remote={{ workstation_backup_remote_parent | quote }}
exclude_file={{ (ansible_facts['env']['HOME'] ~ '/.config/workstation-proton-backup/excludes.txt') | quote }}
max_bytes={{ workstation_backup_restore_test_max_bytes | default(2097152) }}

[[ -x "$cli" ]] || { echo 'ERROR: Proton Drive CLI not executable.' >&2; exit 1; }
[[ -f "$exclude_file" ]] || { echo "ERROR: Missing excludes: $exclude_file" >&2; exit 1; }
command -v rsync >/dev/null || { echo 'ERROR: rsync is not installed.' >&2; exit 1; }
command -v jq >/dev/null || { echo 'ERROR: jq is not installed.' >&2; exit 1; }

sources=(
{% for source in workstation_backup_sources %}
  {{ source | quote }}
{% endfor %}
)

# Pick a random small regular file from the filtered selection of the first
# source that has one.
candidate=""
for source in "${sources[@]}"; do
  source="${source%/}"
  [[ -d "$source" ]] || continue
  name="$(basename "$source")"
  # rsync ignores --out-format in list-only mode: parse the default listing
  # PERMS SIZE DATE TIME NAME (name may contain spaces).
  mapfile -t lines < <(rsync --list-only -m --no-links --exclude-from="$exclude_file" "$source/" \
    | awk -v name="$name" -v max="$max_bytes" '
        $1 ~ /^-/ && $2 ~ /^[0-9]+$/ && ($2+0) <= (max+0) {
          n = $5; for (i = 6; i <= NF; i++) n = n " " $i
          print name "|" n "|" $2
        }')
  {% raw %}
  if ((${#lines[@]} > 0)); then
    candidate="${lines[RANDOM % ${#lines[@]}]}"
    break
  fi
  {% endraw %}
done
[[ -n "$candidate" ]] || { echo 'ERROR: no small file found in the backup selection to test.' >&2; exit 1; }

IFS='|' read -r name rel size <<< "$candidate"
source=""
for s in "${sources[@]}"; do
  [[ "$(basename "${s%/}")" == "$name" ]] && source="${s%/}"
done
[[ -n "$source" ]] || { echo "ERROR: candidate source not found: $name" >&2; exit 1; }

local_file="$source/$rel"
remote_file="$remote/$name/$rel"
[[ -f "$local_file" ]] || { echo "ERROR: local file vanished: $local_file" >&2; exit 1; }
local_sha="$(sha256sum "$local_file" | cut -d' ' -f1)"

tmpdir="$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/workstation-restore-test.XXXXXXXX")"
chmod 0700 "$tmpdir"
trap 'rm -rf -- "$tmpdir"' EXIT

echo "Restore test: downloading $remote_file"
"$cli" filesystem download "$remote_file" "$tmpdir/restored" || {
  echo "ERROR: remote download failed: $remote_file" >&2
  exit 1
}
restored_sha="$(sha256sum "$tmpdir/restored" | cut -d' ' -f1)"

status_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-backup"
mkdir -p "$status_dir"
now="$(date --iso-8601=seconds)"
if [[ "$restored_sha" == "$local_sha" ]]; then
  jq -c --arg t "$now" --arg f "$remote_file" --arg p "proton/drive" --arg s "$local_sha" \
    '{time:$t, provider:$p, file:$f, result:"success", sha256:$s}' \
    >> "$status_dir/restore-tests.jsonl"
  # Update verified_restore_at in the normalized status record without
  # touching the rest of the record.
  if [[ -f "$status_dir/status.json" ]]; then
    jq --arg t "$now" '.verified_restore_at = $t' "$status_dir/status.json" \
      > "$status_dir/status.json.tmp" && mv "$status_dir/status.json.tmp" "$status_dir/status.json"
  fi
  echo "RESTORE TEST OK: $remote_file matches local SHA-256 ($local_sha)"
  exit 0
else
  jq -c --arg t "$now" --arg f "$remote_file" --arg p "proton/drive" --arg ls "$local_sha" --arg rs "$restored_sha" \
    '{time:$t, provider:$p, file:$f, result:"mismatch", local_sha256:$ls, restored_sha256:$rs}' \
    >> "$status_dir/restore-tests.jsonl"
  echo "RESTORE TEST FAILED: $remote_file" >&2
  echo "  local:    $local_sha" >&2
  echo "  restored: $restored_sha" >&2
  exit 1
fi
