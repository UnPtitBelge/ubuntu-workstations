#!/usr/bin/env bash
set -euo pipefail

# Credentials stay in the user's authenticated Proton Drive CLI session.
cli={{ workstation_backup_proton_cli | quote }}
remote={{ workstation_backup_remote_parent | quote }}
exclude_file={{ (ansible_facts['env']['HOME'] ~ '/.config/workstation-proton-backup/excludes.txt') | quote }}
manifest_helper={{ (ansible_facts['env']['HOME'] ~ '/.local/bin/workstation-backup-manifest') | quote }}
manifest_enabled={{ 'true' if workstation_backup_manifest_enabled | default(true) | bool else 'false' }}

usage() {
  echo 'Usage: workstation-proton-backup [--dry-run|--show-excludes]'
  echo '  --dry-run: show filtered file counts and sizes; never upload'
  echo '  --show-excludes: print the Ansible-managed rsync exclude rules'
}
mode=backup
case "${1:-}" in
  '') ;;
  --dry-run) mode=preview ;;
  --show-excludes) mode=excludes ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

[[ -f "$exclude_file" ]] || { echo "ERROR: Missing excludes: $exclude_file" >&2; exit 1; }
if [[ "$mode" == excludes ]]; then
  cat "$exclude_file"
  exit 0
fi
command -v rsync >/dev/null || { echo 'ERROR: rsync is not installed.' >&2; exit 1; }
if [[ "$mode" == backup ]]; then
  [[ -x "$cli" ]] || { echo 'ERROR: Proton Drive CLI not executable.' >&2; exit 1; }
fi

# Verify sources before taking any action.
sources=(
{% for source in workstation_backup_sources %}
  {{ source | quote }}
{% endfor %}
)
for source in "${sources[@]}"; do
  [[ -d "$source" ]] || { echo "ERROR: Missing source directory: $source" >&2; exit 1; }
done

# Avoid source collisions: both Documents directories would map to same remote folder.
declare -A names=()
for source in "${sources[@]}"; do
  normalized="${source%/}"
  name="$(basename "$normalized")"
  [[ -z "${names[$name]+x}" ]] || { echo "ERROR: Duplicate source basename: $name" >&2; exit 1; }
  names["$name"]=1
done

if [[ "$mode" == preview ]]; then
  echo 'DRY RUN — no files will be uploaded.'
  for source in "${sources[@]}"; do
    echo "Filtered preview: $source"
    # rsync requires an actual directory destination, even in dry-run.
    preview_dest="$(mktemp -d)"
    rsync -a -n -m --no-links --stats --exclude-from="$exclude_file" "${source%/}/" "$preview_dest/"
    rmdir "$preview_dest"
  done
  exit 0
fi

# Lock prevents overlapping timer and manual executions.
lockdir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[[ -d "$lockdir" ]] || { echo 'ERROR: User runtime directory unavailable.' >&2; exit 1; }
exec 9>"$lockdir/workstation-proton-backup.lock"
flock -n 9 || { echo 'ERROR: Another Proton backup is running.' >&2; exit 1; }

# Do not create remote folders or change remote files in response to mistakes.
"$cli" filesystem list "$remote" >/dev/null || {
  echo "ERROR: Remote folder inaccessible: $remote" >&2
  exit 1
}

cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$cache_home"
stage="$(mktemp -d "$cache_home/workstation-proton-backup.XXXXXXXX")"
chmod 0700 "$stage"
trap 'rm -rf -- "$stage"' EXIT

# Stage every source first (hardlinks, same filesystem), then upload.
for source in "${sources[@]}"; do
  source="${source%/}"
  name="$(basename "$source")"
  dest="$stage/$name"
  mkdir -p "$dest"
  # Stage via hardlinks, not a full duplicate, provided the staging location
  # and source share a filesystem. Never follow symlinks outside the source.
  if [[ "$(stat -c %d "$source")" != "$(stat -c %d "$stage")" ]]; then
    echo "ERROR: $source is on another filesystem; refusing full-copy staging." >&2
    echo 'Use a staging directory on the same filesystem or select a different source.' >&2
    exit 1
  fi
  echo "Preparing filtered backup: $source"
  rsync -a -m --no-links --link-dest="$source" \
    --exclude-from="$exclude_file" "$source/" "$dest/"
  echo "Selected data (logical size): $(du -sh --apparent-size "$dest" | cut -f1)"
done

# Dataset manifest with per-file SHA-256 (uploaded alongside the data, and
# kept locally) so migrations can compare datasets by checksum, not UI totals.
manifest_local=""
manifest_files=0
manifest_bytes=0
if [[ "$manifest_enabled" == true ]]; then
  manifest_local="$stage/manifest.json"
  manifest_sources=()
  for source in "${sources[@]}"; do
    manifest_sources+=(--source "${source%/}")
  done
  python3 "$manifest_helper" \
    --dataset-id {{ workstation_backup_dataset_id | quote }} \
    --host "$(hostname)" \
    --exclude-file "$exclude_file" \
    "${manifest_sources[@]}" \
    --output "$manifest_local"
  manifest_files="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["file_count"])' "$manifest_local")"
  manifest_bytes="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["total_bytes"])' "$manifest_local")"
fi

for source in "${sources[@]}"; do
  source="${source%/}"
  name="$(basename "$source")"
  echo "Uploading: $name"
  "$cli" filesystem upload "$stage/$name" "$remote" \
    --folder-conflict-strategy {{ workstation_backup_folder_conflict_strategy | quote }} \
    --file-conflict-strategy {{ workstation_backup_file_conflict_strategy | quote }}
done
if [[ -n "$manifest_local" ]]; then
  echo "Uploading dataset manifest: manifest.json"
  "$cli" filesystem upload "$manifest_local" "$remote" \
    --file-conflict-strategy {{ workstation_backup_file_conflict_strategy | quote }}
fi

# Normalized success record consumed by the backup monitor; the provider
# field lets other backup providers write the same schema. verified_restore_at
# is preserved from the last restore drill — an upload never proves restorability.
status_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-backup"
mkdir -p "$status_dir"
verified_restore_at="null"
if [[ -f "$status_dir/status.json" ]]; then
  verified_restore_at="$(jq -r '.verified_restore_at // "null"' "$status_dir/status.json" 2>/dev/null || echo null)"
fi
now="$(date --iso-8601=seconds)"
printf '{"schema_version":1,"capability":"backup","provider":"proton/drive","host":"%s","dataset_id":"%s","checked_at":"%s","result":"success","verified_restore_at":%s,"files":%s,"bytes":%s}\n' \
  "$(hostname)" {{ workstation_backup_dataset_id | quote }} "$now" "$verified_restore_at" "$manifest_files" "$manifest_bytes" \
  > "$status_dir/status.json.tmp"
mv "$status_dir/status.json.tmp" "$status_dir/status.json"
# Append-only history so side-by-side providers keep independent success records.
jq -c '. + {"unit": "workstation-proton-backup.service"}' "$status_dir/status.json" >> "$status_dir/history.jsonl"
cp -f "$status_dir/status.json" "$status_dir/last-run.json" 2>/dev/null || true
if [[ -n "$manifest_local" ]]; then
  cp -f "$manifest_local" "$status_dir/manifest-latest.json"
fi

echo "Completed filtered Proton Drive backup: $now"
