[Unit]
Description=Workstation off-site backup using Proton Drive CLI
Documentation=https://proton.me/blog/offsite-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ ansible_facts['env']['HOME'] }}/.local/bin/workstation-proton-backup
# The desktop keyring may be unavailable without an unlocked GNOME session.
Environment=HOME={{ ansible_facts['env']['HOME'] }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ ansible_facts['user_uid'] }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
