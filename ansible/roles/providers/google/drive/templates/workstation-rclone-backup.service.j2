[Unit]
Description=Workstation off-site backup using rclone (remote: {{ workstation_rclone_remote }})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ ansible_facts['env']['HOME'] }}/.local/bin/workstation-rclone-backup
# The rclone OAuth token is read from ~/.config/rclone/rclone.conf.
Environment=HOME={{ ansible_facts['env']['HOME'] }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ ansible_facts['user_uid'] }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
