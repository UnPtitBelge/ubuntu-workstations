#!/usr/bin/env bash
set -euo pipefail

# rclone-based filtered backup (Google Drive or any rclone remote, e.g. SFTP
# to your own VPS). Credentials stay in the user's rclone config
# (~/.config/rclone/rclone.conf), never in Git or in this script.
remote={{ workstation_rclone_remote | quote }}
remote_parent={{ workstation_rclone_remote_parent | quote }}
exclude_file={{ (ansible_facts['env']['HOME'] ~ '/.config/workstation-rclone-backup/excludes.txt') | quote }}
manifest_helper={{ (ansible_facts['env']['HOME'] ~ '/.local/bin/workstation-backup-manifest') | quote }}
manifest_enabled={{ 'true' if workstation_backup_manifest_enabled | default(true) | bool else 'false' }}

usage() {
  echo 'Usage: workstation-rclone-backup [--dry-run|--show-excludes]'
  echo '  --dry-run: show what would be copied; never upload'
  echo '  --show-excludes: print the Ansible-managed filter rules'
}
mode=backup
case "${1:-}" in
  '') ;;
  --dry-run) mode=preview ;;
  --show-excludes) mode=excludes ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

[[ -f "$exclude_file" ]] || { echo "ERROR: Missing excludes: $exclude_file" >&2; exit 1; }
if [[ "$mode" == excludes ]]; then
  cat "$exclude_file"
  exit 0
fi
cli="$(command -v rclone || true)"
[[ -n "$cli" ]] || { echo 'ERROR: rclone is not installed.' >&2; exit 1; }

# Verify sources before taking any action.
sources=(
{% for source in workstation_backup_sources %}
  {{ source | quote }}
{% endfor %}
)
for source in "${sources[@]}"; do
  [[ -d "$source" ]] || { echo "ERROR: Missing source directory: $source" >&2; exit 1; }
done

# Avoid source collisions: same basename would map to the same remote folder.
declare -A names=()
for source in "${sources[@]}"; do
  normalized="${source%/}"
  name="$(basename "$normalized")"
  [[ -z "${names[$name]+x}" ]] || { echo "ERROR: Duplicate source basename: $name" >&2; exit 1; }
  names["$name"]=1
done

# The remote must exist and be authenticated before anything is uploaded.
"$cli" listremotes | grep -qx "$remote" || {
  echo "ERROR: rclone remote '$remote' is not configured (run: rclone config)." >&2
  exit 1
}
"$cli" lsd "$remote:" >/dev/null 2>&1 || {
  echo "ERROR: rclone remote '$remote:' is not reachable (check auth/network)." >&2
  exit 1
}

# Lock prevents overlapping timer and manual executions.
lockdir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[[ -d "$lockdir" ]] || { echo 'ERROR: User runtime directory unavailable.' >&2; exit 1; }
exec 9>"$lockdir/workstation-rclone-backup.lock"
flock -n 9 || { echo 'ERROR: Another backup is running.' >&2; exit 1; }

rclone_args=(copy --exclude-from="$exclude_file")
[[ "$mode" == preview ]] && rclone_args+=(--dry-run)

for source in "${sources[@]}"; do
  source="${source%/}"
  name="$(basename "$source")"
  echo "Backing up: $source -> $remote:$remote_parent/$name/"
  "$cli" "${rclone_args[@]}" "$source/" "$remote:$remote_parent/$name/"
done

# Dataset manifest with per-file SHA-256 (uploaded alongside the data, and
# kept locally) so migrations can compare datasets by checksum, not UI totals.
status_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-backup"
mkdir -p "$status_dir"
manifest_files=0
manifest_bytes=0
if [[ "$manifest_enabled" == true && "$mode" == backup ]]; then
  manifest_sources=()
  for source in "${sources[@]}"; do
    manifest_sources+=(--source "${source%/}")
  done
  python3 "$manifest_helper" \
    --dataset-id {{ workstation_backup_dataset_id | quote }} \
    --host "$(hostname)" \
    --exclude-file "$exclude_file" \
    "${manifest_sources[@]}" \
    --output "$status_dir/manifest-latest.json"
  manifest_files="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["file_count"])' "$status_dir/manifest-latest.json")"
  manifest_bytes="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["total_bytes"])' "$status_dir/manifest-latest.json")"
  echo "Uploading dataset manifest: manifest.json"
  "$cli" copy "$status_dir/manifest-latest.json" "$remote:$remote_parent/manifest.json"
fi

# Normalized success record consumed by the backup monitor; the provider
# field lets any backup backend write the same schema. Only real runs record
# success — a dry run never updates status. verified_restore_at is preserved
# from the last restore drill — an upload never proves restorability.
if [[ "$mode" == backup ]]; then
  verified_restore_at="null"
  if [[ -f "$status_dir/status.json" ]]; then
    verified_restore_at="$(jq -r '.verified_restore_at // "null"' "$status_dir/status.json" 2>/dev/null || echo null)"
  fi
  now="$(date --iso-8601=seconds)"
  printf '{"schema_version":1,"capability":"backup","provider":"google/drive","host":"%s","dataset_id":"%s","checked_at":"%s","result":"success","verified_restore_at":%s,"files":%s,"bytes":%s}\n' \
    "$(hostname)" {{ workstation_backup_dataset_id | quote }} "$now" "$verified_restore_at" "$manifest_files" "$manifest_bytes" \
    > "$status_dir/status.json.tmp"
  mv "$status_dir/status.json.tmp" "$status_dir/status.json"
  # Append-only history so side-by-side providers keep independent success records.
  jq -c '. + {"unit": "workstation-rclone-backup.service"}' "$status_dir/status.json" >> "$status_dir/history.jsonl"
  echo "Completed filtered rclone backup to $remote: ($now)"
else
  echo "DRY RUN complete — nothing was uploaded and no status was recorded."
fi
